<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小红书更新监控 · 安装" Width="820" Height="540"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="Manual" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="False">
  <Window.Resources>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#F04462"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C3D0E4"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="WindowAction" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A6B5CA"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20FFFFFF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8098B8"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#BBC7D8"/>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" CornerRadius="20" BorderBrush="#30394A" BorderThickness="0.7">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.65"><GradientStop Color="#11151D"/><GradientStop Color="#191C28" Offset="1"/></LinearGradientBrush></Border.Background>
    <Viewbox Stretch="Uniform">
      <Canvas x:Name="Artwork" Width="820" Height="540">
        <Viewbox Canvas.Left="38" Canvas.Top="30" Width="36" Height="36">
          <Canvas Width="104" Height="104">
            <Rectangle Width="104" Height="104" RadiusX="28" RadiusY="28" Fill="#F04462"/>
            <Rectangle Canvas.Left="28" Canvas.Top="23" Width="40" Height="50" RadiusX="10" RadiusY="10" Fill="White" Opacity="0.38"/>
            <Rectangle Canvas.Left="39" Canvas.Top="32" Width="39" Height="49" RadiusX="10" RadiusY="10" Fill="White"/>
            <Path Data="M49,48 L66,48 M49,58 L61,58" Stroke="#F04462" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse Canvas.Left="66" Canvas.Top="19" Width="20" Height="20" Fill="White" Stroke="#F04462" StrokeThickness="4"/>
          </Canvas>
        </Viewbox>
        <TextBlock Canvas.Left="88" Canvas.Top="35" Text="更新监控" FontSize="17" FontWeight="Bold" Foreground="#EBF1FA"/>
        <Button x:Name="Minimize" Canvas.Left="716" Canvas.Top="18" Width="36" Height="32" Style="{StaticResource WindowAction}" AutomationProperties.Name="最小化安装器">
          <Path Data="M0,0 L10,0" Stroke="#A6B5CA" StrokeThickness="1" Width="10" Height="1"/>
        </Button>
        <Button x:Name="Close" Canvas.Left="758" Canvas.Top="18" Width="36" Height="32" Style="{StaticResource WindowAction}" AutomationProperties.Name="关闭安装器">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#A6B5CA" StrokeThickness="1" Width="9" Height="9"/>
        </Button>
        <TextBlock x:Name="Version" Canvas.Left="40" Canvas.Top="104" FontSize="10" Foreground="#96A3B7"/>
        <TextBlock x:Name="Headline" Canvas.Left="38" Canvas.Top="141" Text="把关注，交给它。" FontSize="32" FontWeight="Bold" Foreground="#F2F6FD"/>
        <TextBlock x:Name="Subtitle" Canvas.Left="40" Canvas.Top="211" FontSize="15" Foreground="#96A3B7" LineHeight="21" Text="不必反复打开主页。&#10;新的笔记，让它主动告诉你。"/>
        <Border x:Name="Pill1" Canvas.Left="40" Canvas.Top="290" Width="100" Height="30" CornerRadius="15" Background="#1F2734"><TextBlock Text="多博主监控" Style="{StaticResource PillText}"/></Border>
        <Border x:Name="Pill2" Canvas.Left="150" Canvas.Top="290" Width="100" Height="30" CornerRadius="15" Background="#1F2734"><TextBlock Text="随机检测" Style="{StaticResource PillText}"/></Border>
        <Border x:Name="Pill3" Canvas.Left="260" Canvas.Top="290" Width="100" Height="30" CornerRadius="15" Background="#1F2734"><TextBlock Text="持续提醒" Style="{StaticResource PillText}"/></Border>
        <Border Canvas.Left="550" Canvas.Top="130" Width="224" Height="164" CornerRadius="18" Background="#1C222E"/>
        <TextBlock Canvas.Left="568" Canvas.Top="147" Text="关注动态" FontSize="12" Foreground="#96A3B7"/>
        <Border Canvas.Left="568" Canvas.Top="181" Width="26" Height="26" CornerRadius="8" Background="#572D3E"/>
        <Border Canvas.Left="568" Canvas.Top="214" Width="26" Height="26" CornerRadius="8" Background="#2B3547"/>
        <Border Canvas.Left="568" Canvas.Top="247" Width="26" Height="26" CornerRadius="8" Background="#2B3547"/>
        <Border Canvas.Left="606" Canvas.Top="184" Width="116" Height="5" CornerRadius="2" Background="#647289"/>
        <Border Canvas.Left="606" Canvas.Top="217" Width="90" Height="5" CornerRadius="2" Background="#647289"/>
        <Border Canvas.Left="606" Canvas.Top="250" Width="90" Height="5" CornerRadius="2" Background="#647289"/>
        <Border Canvas.Left="606" Canvas.Top="196" Width="62" Height="4" CornerRadius="2" Background="#374356"/>
        <Border Canvas.Left="606" Canvas.Top="229" Width="62" Height="4" CornerRadius="2" Background="#374356"/>
        <Border Canvas.Left="606" Canvas.Top="262" Width="62" Height="4" CornerRadius="2" Background="#374356"/>
        <Canvas x:Name="ActivityShimmer" Canvas.Left="568" Canvas.Top="181" Width="154" Height="92" IsHitTestVisible="False">
          <Canvas.Clip><RectangleGeometry Rect="0,0,154,92"/></Canvas.Clip>
          <Canvas.OpacityMask><DrawingBrush Stretch="None" Viewbox="0,0,154,92" ViewboxUnits="Absolute" Viewport="0,0,154,92" ViewportUnits="Absolute"><DrawingBrush.Drawing>
            <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><GeometryGroup>
              <RectangleGeometry Rect="0,0,26,26" RadiusX="8" RadiusY="8"/><RectangleGeometry Rect="0,33,26,26" RadiusX="8" RadiusY="8"/><RectangleGeometry Rect="0,66,26,26" RadiusX="8" RadiusY="8"/>
              <RectangleGeometry Rect="38,3,116,5" RadiusX="2" RadiusY="2"/><RectangleGeometry Rect="38,36,90,5" RadiusX="2" RadiusY="2"/><RectangleGeometry Rect="38,69,90,5" RadiusX="2" RadiusY="2"/>
              <RectangleGeometry Rect="38,15,62,4" RadiusX="2" RadiusY="2"/><RectangleGeometry Rect="38,48,62,4" RadiusX="2" RadiusY="2"/><RectangleGeometry Rect="38,81,62,4" RadiusX="2" RadiusY="2"/>
            </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
          </DrawingBrush.Drawing></DrawingBrush></Canvas.OpacityMask>
          <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerBand" Storyboard.TargetProperty="(Canvas.Left)" From="-160" To="224" Duration="0:0:2.8" BeginTime="0:0:0.4"/>
          </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
          <Rectangle x:Name="ShimmerBand" Canvas.Left="-160" Width="120" Height="92">
            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#70FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
          </Rectangle>
        </Canvas>
        <Border Canvas.Left="40" Canvas.Top="350" Width="734" Height="63" CornerRadius="12" Background="#1B212C"/>
        <TextBlock Canvas.Left="56" Canvas.Top="359" Text="安装位置" FontSize="10" Foreground="#96A3B7"/>
        <TextBlock x:Name="Location" Canvas.Left="56" Canvas.Top="377" Width="580" FontSize="12" Foreground="#D6DEEA" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="Change" Canvas.Left="666" Canvas.Top="366" Width="96" Height="32" Content="更改位置" Style="{StaticResource WindowAction}" FontSize="12" AutomationProperties.Name="更改安装位置"/>
        <TextBlock x:Name="Status" Canvas.Left="40" Canvas.Top="439" Width="470" Height="35" FontSize="12" Foreground="#96A3B7" TextWrapping="Wrap" Text="安装即将开始，一切准备就绪"/>
        <TextBlock x:Name="Percent" Canvas.Left="505" Canvas.Top="439" Width="32" TextAlignment="Right" FontSize="12" Foreground="#D6DEEA" Visibility="Hidden" Text="0%"/>
        <Border x:Name="ProgressTrack" Canvas.Left="40" Canvas.Top="480" Width="496" Height="4" CornerRadius="2" Background="#252F40" Visibility="Hidden"/>
        <Border x:Name="ProgressFill" Canvas.Left="40" Canvas.Top="480" Width="0" Height="4" CornerRadius="2" Background="#F04462" Visibility="Hidden"/>
        <Button x:Name="Install" Canvas.Left="572" Canvas.Top="438" Width="212" Height="54" Content="立即安装" FontSize="16" Style="{StaticResource Action}"/>
        <TextBlock x:Name="Footer" Canvas.Left="40" Canvas.Top="502" Text="监控记录与登录信息保存在安装目录的 data 文件夹" FontSize="10" Foreground="#708095"/>
        <Grid x:Name="ShutdownOverlay" Width="820" Height="540" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
          <Border Background="#B20B0E15" CornerRadius="20"/>
          <Border x:Name="ShutdownCard" Width="480" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#202633" BorderBrush="#384355" BorderThickness="1" CornerRadius="18">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.35"/></Border.Effect>
            <StackPanel>
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" Background="#3B2636" CornerRadius="13"><Path Data="M2,3 L22,3 Q24,3 24,5 L24,17 Q24,19 22,19 L2,19 Q0,19 0,17 L0,5 Q0,3 2,3 M7,24 L17,24 M12,19 L12,24" Width="25" Height="25" Stroke="#F56B83" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="后台监控正在运行" FontSize="20" FontWeight="Bold" Foreground="#F2F6FD"/><TextBlock Text="退出后即可继续安装新版本" FontSize="11" Foreground="#9BAAC0" Margin="0,5,0,0"/></StackPanel>
              </Grid>
              <TextBlock Text="需要先关闭后台监控，才能更新程序文件。&#10;是否现在退出并继续安装？" FontSize="13" Foreground="#C3CDDC" LineHeight="23" TextWrapping="Wrap"/>
              <Border Background="#18212B" CornerRadius="10" Padding="14,11" Margin="0,20,0,24"><TextBlock Text="监控记录、设置和登录信息会保留。" FontSize="11" Foreground="#91CBB4"/></Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="ShutdownCancel" Content="暂不安装" Height="44" Background="#303A4A" Foreground="#DCE4F0" FontSize="13" Style="{StaticResource Action}"/>
                <Button x:Name="ShutdownConfirm" Grid.Column="2" Content="关闭后台并继续" Height="44" FontSize="13" FontWeight="SemiBold" Style="{StaticResource Action}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Canvas>
    </Viewbox>
  </Border>
</Window>
